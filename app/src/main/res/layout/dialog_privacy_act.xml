<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:animateLayoutChanges="true"
    android:background="@drawable/bg_bottom_sheet_modern"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle"
        android:layout_marginBottom="16dp"/>

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_banner_icon"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_privacy_shield"
                app:tint="#10B981"
                android:contentDescription="Privacy Shield"/>

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data Privacy Agreement"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Republic Act No. 10173 (Data Privacy Act of 2012)"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp"/>

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/bg_section_divider"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"/>

    <!-- Scrollable Terms -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="300dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="4dp">

            <!-- Section 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Collection of Sensitive Personal Information"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Under Section 13 of the Philippine Data Privacy Act (RA 10173), health information such as blood type, known allergies, pre-existing medical conditions, and emergency contact details are classified as Sensitive Personal Information. BFP Respondo collects these details solely on a voluntary basis."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp"/>

            <!-- Section 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Purpose of Processing"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your emergency profile is processed strictly for emergency dispatch and medical triage. When an SOS alert is transmitted, authorized Bureau of Fire Protection responders receive this information to deliver life-saving interventions."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp"/>

            <!-- Section 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Data Retention and Security"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your medical profile is stored locally on this device in encrypted private storage, and in Google Cloud Firestore if linked to an authenticated account. Respondo enforces industry-standard access control and never sells or discloses your information to unauthorized third parties."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp"/>

            <!-- Section 4 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Your Rights as a Data Subject"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Under RA 10173, you retain the full right to:\n• Access, inspect, and update your profile anytime in this app.\n• Delete or withdraw your medical profile at will.\n• Withhold medical data without forfeiting emergency SOS button functionality."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="14dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- Consent Checkbox Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:padding="14dp"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <CheckBox
            android:id="@+id/chkAgreePrivacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            app:buttonTint="@color/primary"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvAgreePrompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="I have read, understood, and voluntarily agree to the collection and processing of my emergency medical details pursuant to RA 10173."
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"/>

    </LinearLayout>

    <!-- Action Buttons with press scale animation -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAgreePrivacy"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="I Agree &amp; Proceed"
        android:textAllCaps="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:background="@drawable/bg_button_primary_gradient"
        app:backgroundTint="@null"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:elevation="2dp"
        android:stateListAnimator="@animator/btn_press_scale"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeclinePrivacy"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Decline / Back"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:background="@drawable/bg_button_ghost"
        app:backgroundTint="@null"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:cornerRadius="12dp"
        android:elevation="0dp"
        android:stateListAnimator="@animator/btn_press_scale"/>

</LinearLayout>
