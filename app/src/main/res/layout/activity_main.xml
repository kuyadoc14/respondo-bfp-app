<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_weight="1"/>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="8dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:menu="@menu/nav_menu"/>

    </LinearLayout>

    <!-- Global Floating AI Assistant Chathead — Movable, snaps to nearest screen edge -->
    <FrameLayout
        android:id="@+id/btnGlobalVoice"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_ai_bubble"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="76dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="14dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pixel_robot"
            android:contentDescription="BFP AI Assistant"/>

    </FrameLayout>

    <!-- Standby Launch Screen / Splash Overlay while permissions are being granted -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:elevation="30dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp">

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo"
                android:contentDescription="Respondo Logo"/>

            <TextView
                android:id="@+id/splashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESPONDO"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/splashSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUREAU OF FIRE PROTECTION"
                android:textColor="#CE2029"
                android:textSize="12sp"
                android:letterSpacing="0.14"
                android:layout_marginTop="4dp"
                android:textStyle="bold"/>

            <ProgressBar
                android:id="@+id/splashProgress"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:indeterminateTint="#CE2029"
                android:layout_marginTop="36dp"/>

            <TextView
                android:id="@+id/splashStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting for permissions..."
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/btnGrantPermissions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grant Permissions"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="#CE2029"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:layout_marginTop="20dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/btnContinueAnyway"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continue to App"
                android:textColor="#888888"
                android:textSize="13sp"
                android:padding="8dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:text="Emergency Response &amp; First Aid System"
            android:textColor="#555555"
            android:textSize="11sp"
            android:letterSpacing="0.08"/>

    </FrameLayout>

</RelativeLayout>
