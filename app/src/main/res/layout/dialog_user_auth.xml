<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:animateLayoutChanges="true"
    android:background="@drawable/bg_bottom_sheet_modern"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvAuthTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Account (Optional)"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvAuthSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sync your medical profile across devices. SOS functions normally even without an account."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"/>

    <!-- Tabs: Sign In / Create Account -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_chip"
        android:orientation="horizontal"
        android:padding="3dp"
        android:animateLayoutChanges="true"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tabSignIn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Sign In"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/card_bg"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/btn_press_scale"/>

        <TextView
            android:id="@+id/tabRegister"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Create Account"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/btn_press_scale"/>

    </LinearLayout>

    <!-- Email -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email Address"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etAuthEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="name@example.com"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:background="@drawable/bg_input_modern"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="12dp"/>

    <!-- Password -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etAuthPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="At least 6 characters"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:background="@drawable/bg_input_modern"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:inputType="textPassword"
        android:layout_marginBottom="12dp"/>

    <!-- Error message -->
    <TextView
        android:id="@+id/tvAuthError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <!-- Submit button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAuthSubmit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Sign In"
        android:textAllCaps="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:background="@drawable/bg_button_primary_gradient"
        app:backgroundTint="@null"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:elevation="2dp"
        android:stateListAnimator="@animator/btn_press_scale"
        android:layout_marginBottom="8dp"/>

    <!-- Cancel button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAuthCancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:background="@drawable/bg_button_ghost"
        app:backgroundTint="@null"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:cornerRadius="12dp"
        android:elevation="0dp"
        android:stateListAnimator="@animator/btn_press_scale"/>

</LinearLayout>
