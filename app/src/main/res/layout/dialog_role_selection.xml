<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:animateLayoutChanges="true"
    android:background="@drawable/bg_bottom_sheet_modern"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle"
        android:layout_marginBottom="16dp"/>

    <!-- Header Badge + Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_icon"
            android:layout_marginEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_report_alert"
                app:tint="@color/primary"
                android:contentDescription="SOS Dispatched Icon"/>

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOS Dispatched to BFP"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPS sent. Are you involved in this emergency?"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Fading Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/bg_section_divider"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"/>

    <!-- Option 1: Victim -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRoleVictim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface"
        android:foreground="?android:attr/selectableItemBackground"
        android:stateListAnimator="@animator/card_press_scale"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_patient_number_badge"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_victims_count"
                    app:tint="@color/primary"
                    android:contentDescription="Victim Role"/>

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I AM the Victim"
                    android:textColor="@color/primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvVictimSubtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I am injured or in immediate danger. Auto-fills my saved profile to responders."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/primary"
                android:layout_marginStart="8dp"
                android:contentDescription="Select Victim"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Option 2: Bystander -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRoleBystander"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface"
        android:foreground="?android:attr/selectableItemBackground"
        android:stateListAnimator="@animator/card_press_scale"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_info_circle"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Bystander Role"/>

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I am a Bystander"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reporting on behalf of others. Fill in details manually; choose whether to share your info."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary"
                android:layout_marginStart="8dp"
                android:contentDescription="Select Bystander"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Skip Option with press animation -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSkipRole"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Skip Report for Now"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:background="@drawable/bg_button_ghost"
        app:backgroundTint="@null"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:cornerRadius="12dp"
        android:elevation="0dp"
        android:stateListAnimator="@animator/btn_press_scale"/>

</LinearLayout>
