<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Profile"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency Medical Profile &amp; Responder Data"
                android:textColor="#FFD7D7"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Scrollable Profile Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="40dp">

                <!-- Account Status Card -->
                <LinearLayout
                    android:id="@+id/cardAccountStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvAccountIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👤"
                            android:textSize="20sp"
                            android:layout_marginEnd="10dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAccountStatusTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Guest Mode (Local Only)"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvAccountStatusSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Profile is stored on this phone. Sign in to sync across devices."
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="1dp"/>

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUserAuthAction"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Sign In / Register"
                        android:textAllCaps="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="@color/primary_light"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        android:elevation="0dp"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>

                <!-- Medical Profile Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="18dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergency Medical Details"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-filled when you trigger SOS alone or as a victim."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Data Privacy Consent Required Notice (Shown if not yet agreed) -->
                    <LinearLayout
                        android:id="@+id/cardPrivacyPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="8dp"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇵🇭"
                                android:textSize="20sp"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Data Privacy Act Consent Required"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pursuant to Republic Act No. 10173 (Data Privacy Act of 2012), storing sensitive health and medical data requires your explicit consent for emergency response usage."
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="12dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReviewPrivacy"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:text="Review &amp; Agree to RA 10173"
                            android:textAllCaps="false"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="@color/primary"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp"
                            android:elevation="0dp"/>

                    </LinearLayout>

                    <!-- Data Privacy Accepted Status Badge (Shown if agreed) -->
                    <LinearLayout
                        android:id="@+id/cardPrivacyAccepted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_resolved"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textColor="#34C759"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/tvPrivacyConsentDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RA 10173 Data Privacy Consent Accepted"
                            android:textColor="#34C759"
                            android:textSize="11.5sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/btnViewPrivacyPolicy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View Terms"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true"/>

                    </LinearLayout>

                    <!-- Medical Form Fields Container (Gated by Privacy Consent) -->
                    <LinearLayout
                        android:id="@+id/layoutMedicalFormFields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                    <!-- Full Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="e.g. Juan Dela Cruz"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="textPersonName"
                        android:layout_marginBottom="12dp"/>

                    <!-- Phone Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mobile Phone"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etProfilePhone"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="+63 9XX XXX XXXX"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="phone"
                        android:layout_marginBottom="12dp"/>

                    <!-- Age & Birthdate -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Age"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp"/>

                            <EditText
                                android:id="@+id/etProfileAge"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:hint="Age"
                                android:textColorHint="@color/text_hint"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:background="@drawable/bg_input"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:inputType="number"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Birthdate"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp"/>

                            <EditText
                                android:id="@+id/etProfileBirthdate"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:hint="YYYY-MM-DD"
                                android:textColorHint="@color/text_hint"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:background="@drawable/bg_input"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:inputType="date"/>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Home Address -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Address / Barangay"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etProfileAddress"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="House No., Street, Barangay, Municipality"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="textPostalAddress"
                        android:layout_marginBottom="12dp"/>

                    <!-- Blood Type -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blood Type"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etProfileBloodType"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="e.g. O+, A+, B+, AB-"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="textCapCharacters"
                        android:layout_marginBottom="12dp"/>

                    <!-- Allergies -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Known Allergies"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etProfileAllergies"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="e.g. Penicillin, Aspirin, Seafood"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="text"
                        android:layout_marginBottom="12dp"/>

                    <!-- Medical Conditions / Diseases -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medical Conditions / Special Needs"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etProfileConditions"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="e.g. Asthma, Diabetes, Hypertension, Wheelchair"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="text"
                        android:layout_marginBottom="12dp"/>

                    <!-- Emergency Contact Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergency Contact Person"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etProfileEmergencyName"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="Contact name (e.g. Spouse, Parent)"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="textPersonName"
                        android:layout_marginBottom="12dp"/>

                    <!-- Emergency Contact Phone -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergency Contact Phone"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etProfileEmergencyPhone"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="Emergency contact phone number"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="phone"
                        android:layout_marginBottom="18dp"/>

                    <!-- Save Profile Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveProfile"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Save Emergency Profile"
                        android:textAllCaps="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="@color/primary"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        android:elevation="0dp"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- BFP Admin Portal Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_fireman"
                            android:scaleType="fitCenter"
                            android:layout_marginEnd="10dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BFP Administration"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Authorized personnel dashboard &amp; live monitor"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"/>

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoToAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Admin Portal Login"
                        android:textAllCaps="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="@color/primary_dark"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp"
                        android:elevation="0dp"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Admin Login Popup Overlay (preserved) -->
    <FrameLayout
        android:id="@+id/adminLoginOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/adminLoginCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp" />

    </FrameLayout>

</FrameLayout>