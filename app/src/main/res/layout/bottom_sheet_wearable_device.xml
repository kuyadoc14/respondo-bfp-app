<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dark"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#444444"
        android:layout_marginBottom="18dp"/>

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#242424"
            android:gravity="center"
            android:layout_marginEnd="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡"
                android:textSize="22sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESPONDO WEARABLE"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Direct Bluetooth Emergency Device"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Status Card -->
    <LinearLayout
        android:id="@+id/cardDeviceStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#222222"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/circle_dot_gray"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DISCONNECTED"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"/>

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Respondo Wearable"
                android:textColor="#888888"
                android:textSize="12sp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2E2E2E"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MAC Address"
                android:textColor="#777777"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvDeviceMac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A0:DD:6C:74:BE:DC"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:typeface="monospace"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Connection Protocol"
                android:textColor="#777777"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Direct BLE GATT"
                android:textColor="#CCCCCC"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Controls Guide -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1B1B1B"
        android:padding="14dp"
        android:layout_marginBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WEARABLE BUTTON CONTROLS"
            android:textColor="#FF9800"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• 1x Press: Instantly dispatches SOS alert to BFP"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Hold (2s): Confirms VICTIM (sends profile &amp; contacts)"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• 2x Press: Confirms BYSTANDER (reporting for someone else)"
            android:textColor="#E0E0E0"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnConnectToggle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="CONNECT DIRECTLY"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:backgroundTint="#2E7D32"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnOpenBluetoothSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="PAIR IN PHONE SETTINGS"
        android:textColor="#DDDDDD"
        android:textSize="13sp"
        android:backgroundTint="#282828"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnTestSos"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="TEST WEARABLE SOS"
        android:textColor="#FF6B00"
        android:textSize="13sp"
        android:backgroundTint="#241B15"/>

</LinearLayout>
