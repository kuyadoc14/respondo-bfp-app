<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#0A0A0A">

    <!-- Full-screen tap-to-dismiss overlay for menu popup -->
    <View
        android:id="@+id/menuDismissOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Top Left Menu Button (3 Lines -> Triangle morph) -->
    <FrameLayout
        android:id="@+id/btnSosMenu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_menu_button"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        android:stateListAnimator="@animator/btn_press_scale"
        android:contentDescription="Quick Settings Menu">

        <com.bfp.alert.HamburgerTriangleView
            android:id="@+id/hamburgerView"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"/>

    </FrameLayout>

    <!-- Mini List Popup Container on menu side -->
    <androidx.cardview.widget.CardView
        android:id="@+id/menuPopupCard"
        android:layout_width="264dp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="68dp"
        android:layout_marginStart="16dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#1A1A1E"
        app:cardPreventCornerOverlap="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/bg_menu_popup">

            <!-- Header label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK CONTROLS"
                android:textColor="#888899"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginStart="10dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"/>

            <!-- Item 1: Wearable Device Settings -->
            <LinearLayout
                android:id="@+id/bleBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_menu_item_ripple"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/btn_press_scale">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_bluetooth_signal"
                    app:tint="@color/primary"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wearable Device"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <View
                            android:id="@+id/dotBleStatus"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/circle_dot_gray"
                            android:layout_marginEnd="5dp"/>

                        <TextView
                            android:id="@+id/tvBleBadgeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wearable Off"
                            android:textColor="#AAAAAA"
                            android:textSize="11sp"/>

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#666666"
                    android:textSize="16sp"/>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#26262E"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"/>

            <!-- Item 2: Shake SOS Settings -->
            <LinearLayout
                android:id="@+id/btnShakeSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_menu_item_ripple"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/btn_press_scale">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_shake_phone"
                    app:tint="#FF9800"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shake SOS"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvShakeBadgeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergency gesture"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#666666"
                    android:textSize="16sp"/>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#26262E"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"/>

            <!-- Item 3: Hands-Free Mode -->
            <LinearLayout
                android:id="@+id/menuItemHandsFree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_menu_item_ripple"
                android:padding="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_pixel_robot"
                    app:tint="#4CAF50"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hands-Free Mode"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-listen on screen"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchHandsFree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Hands-free toggle"
                    android:scaleX="0.85"
                    android:scaleY="0.85"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Top: Logo + title -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="52dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESPONDO"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bureau of Fire Protection"
            android:textColor="#444444"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <!-- Center: SOS button -->
    <LinearLayout
        android:id="@+id/sosCenter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_centerInParent="true">

        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Outer ripple wave -->
            <View
                android:id="@+id/ringOuter"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_ring_outer"/>

            <!-- Mid ripple wave -->
            <View
                android:id="@+id/ringMid"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_ring_mid"/>

            <!-- SOS button -->
            <Button
                android:id="@+id/btnSOS"
                android:layout_width="186dp"
                android:layout_height="186dp"
                android:layout_gravity="center"
                android:text="SOS"
                android:textSize="46sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:shadowColor="#800000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="4"
                android:gravity="center"
                android:padding="0dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:background="@drawable/bg_sos_button"
                android:stateListAnimator="@null"
                android:elevation="6dp"/>

        </FrameLayout>

        <!-- Instruction -->
        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hold to send emergency alert"
            android:textColor="#3A3A3A"
            android:textSize="13sp"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.01"/>

    </LinearLayout>

    <!-- Status display — unboxed and transparent against the dark background -->
    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:animateLayoutChanges="true"
        android:layout_below="@id/sosCenter"
        android:layout_above="@id/btnVoice"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_centerHorizontal="true"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <!-- Live indicator row -->
        <LinearLayout
            android:id="@+id/liveIndicatorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <View
                android:id="@+id/pulseDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_dot"
                android:layout_marginEnd="7dp"/>

            <TextView
                android:id="@+id/tvLiveLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALERT ACTIVE"
                android:textColor="@color/warning"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textSize="13sp"
            android:gravity="center"
            android:text="Alert sent. Responders have been notified."
            android:lineSpacingExtra="3dp"
            android:textColor="#CCCCCC"
            android:layout_marginBottom="8dp"/>

        <!-- Clickable accident report link with exclamation icon (not a button) -->
        <LinearLayout
            android:id="@+id/btnOpenReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:background="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/btn_press_scale"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/ivReportExclamation"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:text="!"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_exclamation_badge"
                android:layout_marginEnd="7dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accident Report"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ›"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:alpha="0.8"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Voice FAB — replaced by global floating AI button in activity_main -->
    <LinearLayout
        android:id="@+id/btnVoice"
        android:visibility="gone"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_mic_button"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="28dp"
        android:layout_marginEnd="24dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙"
            android:textSize="22sp"/>

    </LinearLayout>

</RelativeLayout>
