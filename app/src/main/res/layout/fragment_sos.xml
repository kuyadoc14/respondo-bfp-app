<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#0A0A0A">

    <!-- BLE badge — top left pill -->
    <LinearLayout
        android:id="@+id/bleBadge"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:visibility="gone"
        android:gravity="center_vertical">

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/circle_dot_green"
            android:layout_marginEnd="7dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESP32"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:letterSpacing="0.04"/>

    </LinearLayout>

    <!-- Top: Logo + title -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="52dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESPONDO"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bureau of Fire Protection"
            android:textColor="#444444"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <!-- Center: SOS button -->
    <LinearLayout
        android:id="@+id/sosCenter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true">

        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:clipChildren="false">

            <!-- Outer ripple wave -->
            <View
                android:id="@+id/ringOuter"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_ring_outer"/>

            <!-- Mid ripple wave -->
            <View
                android:id="@+id/ringMid"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_ring_mid"/>

            <!-- SOS button -->
            <Button
                android:id="@+id/btnSOS"
                android:layout_width="186dp"
                android:layout_height="186dp"
                android:layout_gravity="center"
                android:text="SOS"
                android:textSize="46sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:background="@drawable/bg_sos_button"
                android:stateListAnimator="@null"
                android:elevation="0dp"/>

        </FrameLayout>

        <!-- Instruction -->
        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hold to send emergency alert"
            android:textColor="#3A3A3A"
            android:textSize="13sp"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.01"/>

    </LinearLayout>

    <!-- Status card — below SOS button -->
    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/sosCenter"
        android:layout_marginTop="20dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_centerHorizontal="true"
        android:visibility="gone"
        android:background="#111111"
        android:padding="16dp">

        <!-- Live indicator row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp">

            <View
                android:id="@+id/pulseDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_dot"
                android:layout_marginEnd="7dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:textColor="@color/warning"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="#CCCCCC"/>

    </LinearLayout>

    <!-- Voice FAB — bottom right -->
    <LinearLayout
        android:id="@+id/btnVoice"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_mic_button"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="28dp"
        android:layout_marginEnd="24dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙"
            android:textSize="22sp"/>

    </LinearLayout>

</RelativeLayout>