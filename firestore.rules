rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    // Admin membership is provisioned by a trusted administrator, never by app clients.
    match /admin_users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /sos_alerts/{id} {
      // Anyone can create an alert (ESP32 hardware or mobile user)
      allow create: if true;

      // Anyone can UPDATE accident report details (bystander submitting report)
      allow update: if true;

      // Anyone can READ (victim app must read status to know it's "active" or "resolved")
      allow read: if true;

      // Only provisioned BFP admins can delete alerts
      allow delete: if isAdmin();
    }

    // User profiles — only the owner can read and write their profile
    match /user_profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // First aid — anyone can read, admin writes
    match /first_aid/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // BFP stations — anyone can read, admin writes
    match /bfp_stations/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin tokens — owner only
    match /admin_tokens/{uid} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }

  }
}
